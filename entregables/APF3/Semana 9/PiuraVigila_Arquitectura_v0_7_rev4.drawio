        <mxCell id="title" value="Arquitectura v0.7 rev4 · PiuraVigila · MVC con Service y DAO sobre Spring Boot (Semana 9)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;fontColor=#111827;align=left" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1500" height="32" as="geometry" /></mxCell>
