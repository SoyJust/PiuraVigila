        <mxCell id="L1T" value="Capa de presentación · View (5) · plantillas Thymeleaf" style="text;html=1;strokeColor=none;fillColor=#e9f2fe;align=left;verticalAlign=middle;spacingLeft=6;fontStyle=1;fontColor=#374151;fontSize=12;" vertex="1" parent="1"><mxGeometry x="32" y="52" width="359" height="22" as="geometry" /></mxCell>
